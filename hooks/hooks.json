{
  "description": "SessionStart is silent without saved work. session-budget auto-loads one pending handoff or lists several; offload lists persistent handoffs without taking ownership. Helper paths are resolved by the active skill. UserPromptSubmit fires throttled session-budget nudges.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/core/session-budget/reinit-hook.mjs\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/core/offload/reinit-hook.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/core/session-budget/budget-hook.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
