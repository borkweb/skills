{
  "description": "SessionStart is silent without saved work. session-budget auto-loads one pending handoff or lists several; offload lists persistent handoffs without taking ownership and hands a session that owns a ledger its board. Stop refuses once when that ledger still owes the architect a judgment, ruling or owner. Helper paths are resolved by the active skill. UserPromptSubmit fires throttled session-budget nudges. skill-usage appends the name of each Skill tool call (PreToolUse) and each slash-typed command (UserPromptSubmit) to ~/.agent-handoffs/usage/skills.jsonl; it never blocks and records no arguments. BORK_SKILL_USAGE_LOG=0 turns it off.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/core/session-budget/reinit-hook.mjs\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/core/offload/reinit-hook.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/core/offload/stop-hook.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/skill-usage.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/core/session-budget/budget-hook.mjs\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/skill-usage.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
